{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "noEncodeEdit",
  "mainBinaryName": "noEncodeEdit",
  "version": "1.0.0",
  "identifier": "app.noencodeedit.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "noEncodeEdit",
        "width": 1400,
        "height": 880,
        "minWidth": 1060,
        "minHeight": 680,
        "center": true,
        "visible": false,
        "dragDropEnabled": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "publisher": "vadmonboss",
    "copyright": "© 2026 vadmonboss. GPL-3.0-or-later. Bundled FFmpeg is GPL v3 (see ffmpeg/FFMPEG-LICENSE.txt).",
    "category": "Video",
    "shortDescription": "Lossless video trimming and audio track editing",
    "longDescription": "Trim videos and replace, add or remove audio tracks without re-encoding (FFmpeg stream copy).",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": {
      "resources/ffmpeg/*": "ffmpeg/"
    },
    "fileAssociations": [
      {
        "ext": [
          "nee"
        ],
        "name": "noEncodeEdit Project",
        "description": "noEncodeEdit project",
        "role": "Editor"
      }
    ],
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      },
      "nsis": {
        "installMode": "currentUser",
        "languages": [
          "Russian",
          "English"
        ],
        "displayLanguageSelector": true,
        "installerIcon": "icons/icon.ico"
      }
    },
    "homepage": "https://github.com/vadmonboss/noEncodeEdit"
  }
}
