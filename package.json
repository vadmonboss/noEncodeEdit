{
  "name": "noencodeedit",
  "private": true,
  "version": "1.0.0",
  "description": "Lightweight, fast lossless video trimmer and audio-track editor for Windows (FFmpeg stream copy).",
  "license": "GPL-3.0-or-later",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
